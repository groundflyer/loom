#!/usr/bin/env zsh
set -euo pipefail

showhelp() {
    echo "Usage: $0 [-hs]"
    echo -e "\t-d\tbuild site and serve"
    echo -e "\t-h\tshow this help message and exit"
}

DO_SERVE=false

for key in $@; do
    case $key in
        -s)
            DO_SERVE=true
            DO_DEPLOY=false
            ;;
        -h)
            showhelp
            exit 0
            ;;
        *)
            echo "Unknown option $key"
            showhelp
            exit 1
            ;;
    esac
done

SRC_DIR="${${(%):-%x}:A:h}"
BUILD_DIR="${SRC_DIR}/result"
DEPLOY_DIR=${1:-`mktemp -du`}

nix build \#site

if [[ $DO_SERVE = true ]]; then
    pushd $BUILD_DIR
    python -m http.server
    popd
    exit 0
fi

if [[ ! -d ${DEPLOY_DIR} ]]; then
    git clone git@github.com:groundflyer/loom.git --branch=gh-pages --single-branch ${DEPLOY_DIR}
fi

rm -rfv ${DEPLOY_DIR}/*
rsync -rltv --chmod=+w ${BUILD_DIR}/* ${DEPLOY_DIR}

pushd ${DEPLOY_DIR}
git add -A
git commit -m "[auto] updating the site"
git push origin gh-pages
popd
